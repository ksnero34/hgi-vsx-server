[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req

[dn]
C=KR
ST=Seoul
L=Seoul
O=HGI
OU=IT
CN=vsx.hgi.com

[v3_req]
keyUsage = critical, digitalSignature, keyEncipherment, keyAgreement
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = @alt_names
basicConstraints = CA:FALSE

[alt_names]
DNS.1 = vsx.hgi.com
DNS.2 = localhost
DNS.3 = *.hgi.com
IP.1 = 127.0.0.1
IP.2 = ::1
