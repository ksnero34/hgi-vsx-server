# Core service endpoints
OVSX_REGISTRY_URL=http://server:8080
OVSX_WEBUI_URL=http://webui:3000
OVSX_ELASTICSEARCH_HOST=elasticsearch:9200

# Database connectivity
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
SPRING_DATASOURCE_USERNAME=openvsx
SPRING_DATASOURCE_PASSWORD=openvsx

# GitHub OAuth (optional)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=

# Eclipse OAuth (optional)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_CLIENT_SECRET=

# Custom OAuth provider (OpenID Connect)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_NAME=Custom
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_REDIRECT_URI={baseUrl}/login/oauth2/code/custom
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CUSTOM_ISSUER_URI=

# Attribute mapping overrides (optional, defaults target standard OpenID claims)
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_LOGIN_NAME=preferred_username
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_FULL_NAME=name
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_EMAIL=email
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_AVATAR_URL=picture
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_PROVIDER_URL=profile
