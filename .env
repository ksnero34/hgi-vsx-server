# Public entrypoint (update to your external hostname when deploying)
# Use HTTPS to avoid Content Security Policy (CSP) issues with VSCode
PUBLIC_BASE_URL=https://vsx.hgi.com:28443

# Core service endpoints
OVSX_REGISTRY_URL=http://vsx.hgi.com
OVSX_ELASTICSEARCH_HOST=elasticsearch:9200

# Database connectivity
SPRING_DATASOURCE_URL=jdbc:postgresql://vsxpostgres:5432/postgres
SPRING_DATASOURCE_USERNAME=openvsx
SPRING_DATASOURCE_PASSWORD=openvsx

# GitHub OAuth (disabled - removed to prevent registration)
# Eclipse OAuth (disabled - removed to prevent registration)

# Custom OAuth provider (OpenID Connect)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_ID=92a17cbc-909c-41bb-880e-ce58685da4e4
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_SECRET=Gsr7wwHfQHTkB0cs-Kjs5MBd-ARM9NFGeHBOMZH1M8c
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_NAME=HGI-OIDC
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_REDIRECT_URI=https://vsx.hgi.com:28443/login/oauth2/code/custom
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CUSTOM_ISSUER_URI=http://auth.hwgeneralins.com

# Attribute mapping overrides (optional, defaults target standard OpenID claims)
# Try sub first as login-name (most OIDC providers include this)
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_LOGIN_NAME=sub
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_FULL_NAME=name
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_EMAIL=email
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_AVATAR_URL=picture
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_PROVIDER_URL=iss

## zipkin disable
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.actuate.autoconfigure.tracing.zipkin.ZipkinAutoConfiguration