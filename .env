# Public entrypoint (update to your external hostname when deploying)
# Use HTTPS to avoid Content Security Policy (CSP) issues with VSCode
PUBLIC_BASE_URL=https://vsx.hgi.com:28443

# Core service endpoints
OVSX_REGISTRY_URL=http://vsx.hgi.com
OVSX_ELASTICSEARCH_HOST=elasticsearch:9200

# Database connectivity
SPRING_DATASOURCE_URL=jdbc:postgresql://vsxpostgres:5432/postgres
SPRING_DATASOURCE_USERNAME=openvsx
SPRING_DATASOURCE_PASSWORD=openvsx

# GitHub OAuth (optional)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=dummy
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=dummy
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_REDIRECT_URI=http://vsx.hgi.com:28080/login/oauth2/code/github
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_SCOPE=read:user,user:email
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_GITHUB_AUTHORIZATION_URI=https://github.com/login/oauth/authorize
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_GITHUB_USER_INFO_URI=https://api.github.com/user
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_GITHUB_USER_NAME_ATTRIBUTE=login

# Eclipse OAuth (optional)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_CLIENT_ID=dummy
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_CLIENT_SECRET=dummy
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_REDIRECT_URI=http://vsx.hgi.com:28080/login/oauth2/code/eclipse
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ECLIPSE_SCOPE=openvsx_publisher_agreement,profile
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ECLIPSE_AUTHORIZATION_URI=https://accounts.eclipse.org/oauth2/authorize
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ECLIPSE_TOKEN_URI=https://accounts.eclipse.org/oauth2/token
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ECLIPSE_USER_INFO_URI=https://accounts.eclipse.org/oauth2/UserInfo
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ECLIPSE_USER_NAME_ATTRIBUTE=name
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ECLIPSE_USER_INFO_AUTHENTICATION_METHOD=header

# Custom OAuth provider (OpenID Connect)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_ID=92a17cbc-909c-41bb-880e-ce58685da4e4
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_SECRET=Gsr7wwHfQHTkB0cs-Kjs5MBd-ARM9NFGeHBOMZH1M8c
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_CLIENT_NAME=HGI-OIDC
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CUSTOM_REDIRECT_URI=https://vsx.hgi.com:28443/login/oauth2/code/custom
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CUSTOM_ISSUER_URI=http://auth.hwgeneralins.com

# Attribute mapping overrides (optional, defaults target standard OpenID claims)
# Try sub first as login-name (most OIDC providers include this)
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_LOGIN_NAME=sub
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_FULL_NAME=name
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_EMAIL=email
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_AVATAR_URL=picture
OVSX_OAUTH2_ATTRIBUTE_NAMES_CUSTOM_PROVIDER_URL=iss
